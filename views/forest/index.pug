extends ../layout

block append head
  link(rel='stylesheet' href='/css/owner-forest.css')
  if forestStatus === 'not-established'
    script(type='module' src='/js/owner-forest-garden-start.js')
  if forestStatus === 'ready'
    script(type='module' src='/js/owner-forest.js')

block nav
  include ../navLinks

block content
  main.owner-forest(aria-labelledby='owner-forest-title')
    header.owner-forest__header
      div
        p.owner-forest__eyebrow= t('forestScene.eyebrow')
        h1#owner-forest-title= t('forestScene.heading')
        p.owner-forest__lede= t('forestScene.introduction')
      .owner-forest__actions
        a.button(href=uiPath('/forest/writing'))= t('forestScene.browseWriting')
        if forestStatus === 'ready'
          button(type='button' data-owner-forest-reset)= t('forestScene.returnToCenter')

    if forestStatus === 'not-established'
      .owner-forest__notice(role='status')
        h2= t('forestScene.empty.heading')
        p= t('forestScene.empty.body')
        p A wild lanternbell awaits near the entrance.
        button(type='button' data-garden-establish) Enter my forest
        p(data-garden-establish-status role='status' aria-live='polite')
    else if forestStatus === 'reconciling'
      .owner-forest__notice(role='status')
        h2= t('forestScene.reconciling.heading')
        p= t('forestScene.reconciling.body')
        a.button(href=uiPath('/forest'))= t('forestScene.reconciling.retry')
    else if forestStatus === 'unavailable'
      .owner-forest__notice(role='alert')
        h2= t('forestScene.unavailable.heading')
        p= t('forestScene.unavailable.body')
    else
      p#owner-forest-help.owner-forest__help= t('forestScene.help')
      .owner-forest__stage(data-owner-forest-stage)
        .owner-forest__viewport(
          tabindex='0'
          role='application'
          aria-label=t('forestScene.viewportLabel')
          aria-describedby='owner-forest-help'
          data-owner-forest-viewport
        )
          canvas.owner-forest__canvas(data-owner-forest-canvas)
          .owner-forest__joystick(data-owner-forest-joystick hidden aria-hidden='true')
            .owner-forest__joystick-stick(data-owner-forest-joystick-stick)
          .owner-forest__status-stack
            p.owner-forest__status(data-owner-forest-status role='status' aria-live='polite')
              = t('forestScene.loading')
            .owner-forest__authored-status(
              data-owner-forest-authored-status
              role='status'
              aria-live='polite'
            )
              span(data-owner-forest-authored-status-copy)= t('forestScene.markers.loading')
              button(type='button' data-owner-forest-authored-retry hidden)
                = t('forestScene.markers.retrySync')
            .owner-forest__sync-status(
              data-owner-forest-sync-status
              role='status'
              aria-live='polite'
              hidden
            )
              span(data-owner-forest-sync-status-copy)
              .owner-forest__sync-actions(data-owner-forest-sync-actions hidden)
                button(type='button' data-owner-forest-sync-retry)
                  = t('forestScene.markers.retryPending')
                button(type='button' data-owner-forest-sync-revert)
                  = t('forestScene.markers.revertPending')
          .owner-forest__placement(data-owner-forest-placement hidden)
            section(data-owner-forest-placement-writing hidden)
              h3(data-owner-forest-placement-writing-title)
              p(data-owner-forest-placement-writing-help)
            p(data-owner-forest-placement-status role='status' aria-live='polite')
            .owner-forest__placement-actions
              button(type='button' data-owner-forest-placement-save)
                = t('forestScene.markers.save')
              button(type='button' data-owner-forest-placement-cancel)
                = t('forestScene.markers.cancel')
          .owner-forest__hud-actions
            .owner-forest__nearby(data-owner-forest-nearby hidden)
              span(data-owner-forest-nearby-copy)= t('forestScene.treeNearby')
            button.owner-forest__hud-inspect(type='button' data-owner-forest-inspect)= t('forestScene.inspect.action')
            button.owner-forest__place-marker(
              type='button'
              data-owner-forest-place-marker
              disabled
            )= t('forestScene.markers.place')
          p.owner-forest__garden-notice(data-garden-notice role='status' aria-live='polite' hidden)
          button.owner-forest__garden-open(type='button' data-garden-open aria-controls='forest-garden-panel' aria-expanded='false') Satchel
          button.owner-forest__garden-plant(type='button' data-garden-plant aria-keyshortcuts='P' hidden disabled) Plant cutting · P
          .owner-forest__garden-preview(data-garden-toolbar hidden)
            p(data-garden-preview role='status' aria-live='polite')
            .owner-forest__garden-actions
              button(type='button' data-garden-save) Save here
              button(type='button' data-garden-cancel) Cancel
          section.owner-forest__garden-near(data-garden-near hidden aria-label='Nearby lanternbell')
            p(data-garden-near-copy role='status' aria-live='polite')
            .owner-forest__garden-actions(data-garden-near-actions)
              button(type='button' data-garden-acquire disabled) Take a cutting · E
              button(type='button' data-garden-harvest) Take a cutting · E
              button(type='button' data-garden-move aria-describedby='garden-action-help') Move
              button(type='button' data-garden-lift aria-describedby='garden-action-help') Pack up
            p#garden-action-help.owner-forest__garden-action-help(data-garden-action-help hidden) Move keeps growth. Pack up returns a cutting.
            section(data-garden-confirm hidden)
              p(data-garden-lift-copy) Pack this plant as one cutting? Planting it again starts growth over.
              .owner-forest__garden-actions
                button(type='button' data-garden-confirm-lift) Pack up plant
                button(type='button' data-garden-keep) Keep growing
          section#forest-garden-panel.owner-forest__garden(data-forest-garden hidden aria-labelledby='garden-title')
            .owner-forest__garden-header
              h2#garden-title Satchel & garden
              button(type='button' data-garden-close aria-label='Close satchel') ×
            .owner-forest__garden-holding
              canvas(width='40' height='40' data-garden-cutting role='img' aria-label='Lanternbell cutting: a leafy stem with an amber bud')
              div
                strong Lanternbell cuttings
                p(data-garden-count) Loading…
            .owner-forest__garden-actions
              button(type='button' data-garden-start disabled) Plant a cutting
              button(type='button' data-garden-refresh) Refresh
            p(data-garden-guide)
            p(data-garden-status role='status' aria-live='polite') Loading…
            details
              summary My lanternbells
              ol(data-garden-plants)
            details
              summary Growing tips
              p Sprout in 2 minutes. Flowers in 20. Later cuttings take 4 hours. No watering needed.
          .owner-forest__inspection-backdrop(
            aria-hidden='true'
            data-owner-forest-inspection-backdrop
            hidden
          )
          aside.owner-forest__inspection(
            role='dialog'
            aria-label=t('forestScene.inspect.eyebrow')
            data-owner-forest-inspection
            hidden
          )
            .owner-forest__inspection-header
              p.owner-forest__eyebrow= t('forestScene.inspect.eyebrow')
              button.owner-forest__inspection-close(
                type='button'
                aria-label=t('forestScene.inspect.close')
                data-owner-forest-inspection-close
              ) ×
            .owner-forest__inspection-scroll
              p.owner-forest__inspection-status(
                role='status'
                aria-live='polite'
                data-owner-forest-inspection-status
              )
              .owner-forest__inspection-content(data-owner-forest-inspection-content hidden)
                h2#owner-forest-inspection-title(data-owner-forest-inspection-title)
                p.owner-forest__inspection-meta
                  time(data-owner-forest-inspection-date)
                  span(aria-hidden='true') ·
                  span(data-owner-forest-inspection-language)
                p.owner-forest__inspection-botanical(data-owner-forest-inspection-species)
                a.button.owner-forest__read-post(data-owner-forest-inspection-link)
                  = t('forestScene.inspect.readPost')
                button.owner-forest__mark-writing(type='button' data-owner-forest-mark-writing
                  hidden=!(bootstrap.delivery && bootstrap.delivery.writingLinkCreationEnabled) disabled)= t('forestScene.markers.markWriting')
                .owner-forest__translations(data-owner-forest-translations-wrap hidden)
                  h3= t('forestScene.inspect.translations')
                  ul(data-owner-forest-translations)
                  button(type='button' data-owner-forest-translations-more hidden)
                    = t('forestScene.inspect.moreTranslations')
                .owner-forest__inclusion-actions
                  button.owner-forest__hide-tree(type='button' data-owner-forest-hide-tree)
                    = t('forestScene.inspect.hide')
                  a.owner-forest__manage-hidden(href=uiPath('/forest/writing?view=hidden'))
                    = t('forestScene.inspect.manageHidden')
          aside.owner-forest__inspection.owner-forest__marker-inspection(
            role='dialog'
            aria-labelledby='owner-forest-marker-title'
            data-owner-forest-marker-inspection
            hidden
          )
            .owner-forest__inspection-header
              p.owner-forest__eyebrow= t('forestScene.markers.eyebrow')
              button.owner-forest__inspection-close(
                type='button'
                aria-label=t('forestScene.markers.close')
                data-owner-forest-marker-close
              ) ×
            .owner-forest__inspection-scroll
              h2#owner-forest-marker-title(data-owner-forest-marker-writing-title)= t('forestScene.markers.heading')
              p.owner-forest__marker-description(data-owner-forest-marker-description)= t('forestScene.markers.description')
              p.owner-forest__inspection-status(data-owner-forest-marker-writing-status role='status' aria-live='polite')
              section(data-owner-forest-marker-writing hidden)
                a.button.owner-forest__read-post(data-owner-forest-marker-writing-link)= t('forestScene.inspect.readPost')
              p.owner-forest__inspection-status(
                data-owner-forest-marker-status
                role='status'
                aria-live='polite'
              )
              .owner-forest__marker-management(data-owner-forest-marker-actions)
                .owner-forest__marker-actions
                  button(type='button' data-owner-forest-marker-move)
                    = t('forestScene.markers.move')
                  button(type='button' data-owner-forest-marker-remove)
                    = t('forestScene.markers.remove')
                a.owner-forest__manage-hidden(href=uiPath('/forest/writing?view=marked') data-owner-forest-marker-list hidden)= t('forestScene.markers.markedWriting')
              .owner-forest__marker-confirm(data-owner-forest-marker-confirm hidden)
                p= t('forestScene.markers.removeConfirmation')
                .owner-forest__marker-actions
                  button(type='button' data-owner-forest-marker-remove-confirm)
                    = t('forestScene.markers.confirmRemove')
                  button(type='button' data-owner-forest-marker-remove-cancel)
                    = t('forestScene.markers.cancel')
      noscript
        .owner-forest__notice
          p= t('forestScene.noScript')
          a(href=uiPath('/forest/writing'))= t('forestScene.browseWriting')
      script#owner-forest-bootstrap(type='application/json')!= JSON.stringify(bootstrap).replace(/</g, '\u003c')
      -
        const forestCopy = {
          terrainUnavailable: t('forestScene.terrainUnavailable'),
          terrainReload: t('forestScene.terrainReload'),
          inspectionLoading: t('forestScene.inspect.loading'),
          inspectionUnavailable: t('forestScene.inspect.unavailable'),
          inspectionReconciling: t('forestScene.inspect.reconciling'),
          inclusionSaving: t('forestScene.inspect.inclusionSaving'),
          inclusionConflict: t('forestScene.inspect.inclusionConflict'),
          inclusionUnavailable: t('forestScene.inspect.inclusionUnavailable'),
          treeHidden: t('forestScene.inspect.treeHidden'),
          markers: {
            heading: t('forestScene.markers.heading'),
            description: t('forestScene.markers.description'),
            writingHeading: t('forestScene.markers.writingHeading'),
            writingDescription: t('forestScene.markers.writingDescription'),
            writingNearby: t('forestScene.markers.writingNearby'),
            inspectionUnavailable: t('forestScene.markers.inspectionUnavailable'),
            writingUnavailable: t('forestScene.markers.writingUnavailable'),
            previewWritingDistance: t('forestScene.markers.previewWritingDistance'),
            linkedWriting: t('forestScene.markers.linkedWriting'),
            linkedMove: t('forestScene.markers.linkedMove'),
            linkedPlacement: t('forestScene.markers.linkedPlacement'),
            linksDisabled: t('forestScene.markers.linksDisabled'),
            loading: t('forestScene.markers.loading'),
            ready: t('forestScene.markers.ready'),
            unavailable: t('forestScene.markers.unavailable'),
            stale: t('forestScene.markers.stale'),
            migrationRequired: t('forestScene.markers.migrationRequired'),
            resetting: t('forestScene.markers.resetting'),
            treeNearby: t('forestScene.treeNearby'),
            markerNearby: t('forestScene.markers.nearby'),
            inspectTree: t('forestScene.inspect.action'),
            inspectMarker: t('forestScene.markers.inspect'),
            save: t('forestScene.markers.save'),
            move: t('forestScene.markers.move'),
            previewClear: t('forestScene.markers.previewClear'),
            previewTerrainCollision: t('forestScene.markers.previewTerrainCollision'),
            previewTreeCollision: t('forestScene.markers.previewTreeCollision'),
            previewMarkerCollision: t('forestScene.markers.previewMarkerCollision'),
            previewBounds: t('forestScene.markers.previewBounds'),
            previewDensity: t('forestScene.markers.previewDensity'),
            saving: t('forestScene.markers.saving'),
            moving: t('forestScene.markers.moving'),
            saved: t('forestScene.markers.saved'),
            moved: t('forestScene.markers.moved'),
            conflict: t('forestScene.markers.conflict'),
            collision: t('forestScene.markers.collision'),
            density: t('forestScene.markers.density'),
            unavailableMutation: t('forestScene.markers.unavailableMutation'),
            rateLimited: t('forestScene.markers.rateLimited'),
            removedElsewhere: t('forestScene.markers.removedElsewhere'),
            removeSaving: t('forestScene.markers.removeSaving'),
            removed: t('forestScene.markers.removed'),
            retrySave: t('forestScene.markers.retrySave'),
            retryMove: t('forestScene.markers.retryMove'),
            retryRemove: t('forestScene.markers.retryRemove'),
            syncingPending: t('forestScene.markers.syncingPending'),
            syncingPendingMany: t('forestScene.markers.syncingPendingMany'),
            unsyncedPending: t('forestScene.markers.unsyncedPending'),
            unsyncedPendingMany: t('forestScene.markers.unsyncedPendingMany'),
            pendingMarker: t('forestScene.markers.pendingMarker'),
            pendingMarkerFailed: t('forestScene.markers.pendingMarkerFailed'),
            retryPending: t('forestScene.markers.retryPending'),
            revertPending: t('forestScene.markers.revertPending'),
            revertedPending: t('forestScene.markers.revertedPending'),
            confirmRemove: t('forestScene.markers.confirmRemove')
          },
          treeTypes: {
            'open-crown-deciduous': t('forestScene.treeTypes.deciduous'),
            'sunset-lanternwood': t('forestScene.treeTypes.lanternwood'),
            'wind-shaped-highland-conifer': t('forestScene.treeTypes.conifer')
          },
          unknownTreeType: t('forestScene.treeTypes.unknown'),
          seasons: {
            spring: t('forestScene.seasons.spring'),
            summer: t('forestScene.seasons.summer'),
            autumn: t('forestScene.seasons.autumn'),
            winter: t('forestScene.seasons.winter'),
            unknown: t('forestScene.seasons.unknown')
          }
        };
      script#owner-forest-copy(type='application/json')!= JSON.stringify(forestCopy).replace(/</g, '\u003c')
